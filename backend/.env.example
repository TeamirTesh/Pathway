DATABASE_URL=postgresql://...
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback
GMAIL_TOKEN_SECRET=          # 64 hex characters
ANTHROPIC_API_KEY=
CLIENT_URL=http://localhost:8080
PORT=3000

# LaTeX compilation (all optional — sane defaults below)
TECTONIC_BIN=tectonic                # path to the tectonic binary; plain "tectonic" resolves via PATH
RESUME_COMPILE_TIMEOUT_MS=20000      # hard kill timeout per compile
RESUME_COMPILE_CONCURRENCY=          # max concurrent compiles; defaults to (CPU cores - 1)
